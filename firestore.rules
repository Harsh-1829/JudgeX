rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return hasUserData() && getUserData().role == 'ADMIN';
    }

    function isJudge() {
      return hasUserData() && getUserData().role == 'JUDGE';
    }

    function isTeamLeader() {
      return hasUserData() && getUserData().role == 'TEAM_LEADER';
    }

    // Organizations Collection (Multi-college tenant boundaries)
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      // An authenticated user can register a new organization where they are the designated admin
      allow create: if isAuthenticated() && request.resource.data.adminUid == request.auth.uid;
      // Only the designated organization admin can update institutional details
      allow update: if isAuthenticated() && (isAdmin() && resource.data.adminUid == request.auth.uid);
      allow delete: if false; // Tenant preservation
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Admin can provision users; Users can create their own profile during initial registration.
      // If creating an ADMIN role, user must be the designated adminUid in the corresponding organization doc.
      allow create: if isAuthenticated() && 
                    (isAdmin() || 
                     (request.auth.uid == userId && 
                      (request.resource.data.role != 'ADMIN' || 
                       (exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)) && 
                        get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.adminUid == request.auth.uid))));
      // Admin can update; User can update non-privileged fields without modifying their role
      allow update: if isAuthenticated() && 
                     (isAdmin() || 
                      (request.auth.uid == userId && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    // Events Collection (Admin-configured competitions)
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Panels Collection (Admin-controlled panels and venue assignments)
    match /panels/{panelId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Criteria Collection (Dynamic rubrics)
    match /criteria/{criterionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Teams Collection
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      // Admin can update; Team leader can update team details without altering panel or event assignments
      allow update: if isAdmin() || 
                     (isTeamLeader() && 
                      resource.data.leaderUid == request.auth.uid &&
                      request.resource.data.panelId == resource.data.panelId &&
                      request.resource.data.eventId == resource.data.eventId);
    }

    // Evaluations Collection
    match /evaluations/{evalId} {
      // Drafts can only be read by the evaluating judge or admin; submitted evaluations can be read by authenticated users
      allow read: if isAuthenticated() && 
                    (resource.data.status == 'SUBMITTED' || 
                     resource.data.judgeId == request.auth.uid || 
                     isAdmin());
      // Judges and Admins can create evaluations; judgeId must match auth user
      allow create: if isAuthenticated() && 
                     (isAdmin() || (isJudge() && request.resource.data.judgeId == request.auth.uid));
      // Only Admin or the evaluating judge updating an in-progress DRAFT can modify; SUBMITTED evaluations cannot be edited by judges
      allow update: if isAuthenticated() && 
                     (isAdmin() || 
                      (isJudge() && 
                       resource.data.judgeId == request.auth.uid && 
                       resource.data.status == 'DRAFT'));
      allow delete: if isAdmin();
    }
  }
}
